{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vetted-north",
	// worker.ts wraps the built site (.open-next/worker.js) and adds the weekly scheduled job.
	"main": "worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference used by the adapter. Must match "name" above.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "vetted-north"
		}
	],
	"vars": {
		"SITE_URL": "https://vettednorth.com",
		// Optional overrides. Without them, emails are sent from, and admin copies
		// go to, the contact address in src/config/site.ts:
		// "EMAIL_FROM": "Name <hello@example.com>", "ADMIN_EMAIL": "you@example.com",
		// Address used in links in emails (feedback requests, the Specialist
		// terms link). vettednorth.com is connected to this Worker (November 2026).
		"LINK_ORIGIN": "https://vettednorth.com"
	},
	// Enquiries, saved answers, registrations and applications. The site
	// creates its own tables (see src/lib/records.ts).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vetted-north-database",
			"database_id": "56d02c78-f596-411e-bebc-3f03a497a4d3"
		}
	],
	// RESEND_API_KEY is a secret: set it in the Cloudflare dashboard, never here.
	"triggers": {
		// Mondays 07:05 UTC: weekly reports. Daily 09:40 UTC: feedback emails. See worker.ts.
		"crons": ["5 7 * * 1", "40 9 * * *"]
	},
	"observability": {
		"enabled": true
	}
}
