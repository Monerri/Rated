{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vetted-north",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference used by the adapter. Must match "name" above.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "vetted-north"
		}
	],
	"vars": {
		"SITE_URL": "https://vettednorth.com",
		// Sender for every email. The domain must be verified in Resend.
		"EMAIL_FROM": "Vetted North <hello@vettednorth.com>",
		// Receives copies of emails meant for demonstration specialists.
		"ADMIN_EMAIL": "hello@vettednorth.com"
	},
	// Enquiries, saved answers, registrations and applications. The site
	// creates its own tables (see src/lib/records.ts).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vetted-north-database",
			"database_id": "56d02c78-f596-411e-bebc-3f03a497a4d3"
		}
	],
	// RESEND_API_KEY is a secret: set it in the Cloudflare dashboard, never here.
	"observability": {
		"enabled": true
	}
}
